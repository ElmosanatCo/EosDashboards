{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "<production-host-name>",
  "ConnectionStrings": {
    "EosDashboard": "Server=<sql-server>;Database=<company-database>;Integrated Security=True;Encrypt=True;TrustServerCertificate=False"
  },
  "ApiSecurity": {
    "AllowedOrigins": [
      "https://<ui-host-name>"
    ]
  },
  "AuthSecurity": {
    "HashingKey": "<generate-a-long-random-secret>",
    "SigningKey": "<generate-a-long-random-secret>",
    "Issuer": "<production-issuer>",
    "Audience": "<production-audience>",
    "AccessTokenLifetime": "00:10:00",
    "SessionLifetime": "08:00:00",
    "KeyRingPath": "C:\\ProgramData\\EosDashboards\\keys"
  },
  "GoogleAuthentication": {
    "Enabled": false,
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "https://<api-host-name>/EosDashboardsApi/api/v1/auth/google/callback",
    "BackchannelProxyUri": ""
  },
  "Sms": {
    "Endpoint": "<company-sms-endpoint>",
    "Timeout": "00:00:10"
  }
}
